{
  "name": "pdf-layout-designer",
  "version": "2.0.0",
  "description": "Production-grade PDF Layout Designer with NetSuite integration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:netsuite": "tsc && vite build --mode netsuite",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource/sarabun": "^5.2.8",
    "@lit/context": "^1.1.0",
    "@lit/task": "^1.0.0",
    "bwip-js": "^4.3.0",
    "file-saver": "^2.0.5",
    "hotkeys-js": "^3.13.7",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.1",
    "lit": "^3.2.0",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.17",
    "@tailwindcss/vite": "^4.0.0",
    "@vitest/ui": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "storybook": "^8.6.17",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
