{
  "name": "pdf-layout-designer",
  "version": "2.0.0",
  "description": "Production-grade PDF Layout Designer with NetSuite integration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:netsuite": "tsc && vite build --mode netsuite",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@fontsource/sarabun": "^5.2.8",
    "@lit/context": "^1.1.0",
    "@lit/task": "^1.0.0",
    "bwip-js": "^4.3.0",
    "file-saver": "^2.0.5",
    "hotkeys-js": "^3.13.7",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "lit": "^3.2.0",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/web-components-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.0.0",
    "@vitest/ui": "^3.2.7",
    "eslint": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
